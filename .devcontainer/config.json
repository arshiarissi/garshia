{
  "inbounds": [
    {
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [{"id": "__UUID__"}],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "mode": "packet-up",
          "path": "/"
        }
      }
    }
  ],
  "outbounds": [{"protocol": "freedom"}],
  "log": {
    "loglevel": "warning",
    "access": "/tmp/xray.log",
    "error": "/tmp/xray_error.log"
  }
}